# 复制为 .env 后供 docker-compose 使用；后端 application.yml 的默认值与此一致。

# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=linkgame
MYSQL_PORT=3306

# Redis
REDIS_PORT=6379

# 后端连接配置（与 application.yml 中的 ${DB_*}/${REDIS_*} 占位符对应）
DB_HOST=localhost
DB_PORT=3306
DB_NAME=linkgame
DB_USERNAME=root
DB_PASSWORD=root
REDIS_HOST=localhost